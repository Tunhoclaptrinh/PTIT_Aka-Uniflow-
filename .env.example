# ==============================================================================
# UNIFLOW AI - GLOBAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- [APP ENVIRONMENT] ---
NODE_ENV=development
PORT=3000
AI_ENGINE_PORT=8000
FRONTEND_PORT=5173

# --- [BRAND COLORS & THEMING] ---
BRAND_PRIMARY_COLOR="#ed1c24"
BRAND_SECONDARY_COLOR="#fcc20f"
BRAND_NAME="UniFlow AI"

# --- [SECURITY & ENCRYPTION] ---
# Secret key 32 bytes for AES-256-GCM token encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="uniflow-jwt-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# --- [DATABASES] ---
# MongoDB Configuration (Phase 1 MVP)
MONGO_URI="mongodb://uniflow_admin:uniflow_secret_2026@localhost:27017/uniflow_db?authSource=admin"
MONGO_DB_NAME="uniflow_db"

# PostgreSQL Configuration (Phase 2 Scale)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="uniflow"
POSTGRES_PASSWORD="uniflow_pg_password"
POSTGRES_DB="uniflow_production"

# Redis Cache & Message Queue
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="uniflow_redis_secret"
REDIS_DB=0

# --- [VECTOR DATABASE] ---
# Qdrant Vector Engine
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME="uniflow_sku_vectors"
QDRANT_API_KEY=""

# --- [AI SERVICES] ---
# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# AI Engine Internal Service URL
AI_ENGINE_URL="http://localhost:8000"

# --- [BACKEND INTERNAL SERVICE URL] ---
BACKEND_INTERNAL_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# --- [MARKETPLACE & PARTNER INTEGRATION SECRETS] ---
# TikTok Shop Open API
TIKTOK_APP_KEY="your_tiktok_app_key"
TIKTOK_APP_SECRET="your_tiktok_app_secret"
TIKTOK_WEBHOOK_SECRET="your_tiktok_webhook_hmac_secret"

# Shopee Open Platform
SHOPEE_PARTNER_ID="your_shopee_partner_id"
SHOPEE_PARTNER_KEY="your_shopee_partner_key"

# KiotViet API
KIOTVIET_CLIENT_ID="your_kiotviet_client_id"
KIOTVIET_CLIENT_SECRET="your_kiotviet_client_secret"

# Sapo API
SAPO_API_KEY="your_sapo_api_key"
SAPO_SECRET_KEY="your_sapo_secret_key"

# Logistics (GHN / GHTK / Viettel Post)
GHN_API_TOKEN="your_ghn_api_token"
GHN_SHOP_ID="123456"
GHTK_API_TOKEN="your_ghtk_api_token"
VIETTELPOST_USER=""
VIETTELPOST_PASSWORD=""

# --- [NOTIFICATIONS] ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_ALERT_CHAT_ID="your_telegram_chat_id"
ZALO_ZNS_ACCESS_TOKEN="your_zalo_zns_token"
