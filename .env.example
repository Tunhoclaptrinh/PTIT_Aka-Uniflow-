# ==============================================================================
# UNIFLOW AI - GLOBAL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- [APP ENVIRONMENT] ---
NODE_ENV="development"
PORT=3000
AI_ENGINE_PORT=8000
FRONTEND_PORT=5173

# --- [BRAND COLORS & THEMING] ---
BRAND_PRIMARY_COLOR="#ed1c24"
BRAND_SECONDARY_COLOR="#fcc20f"
BRAND_NAME="UniFlow AI"

# --- [SECURITY & ENCRYPTION] ---
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="uniflow-jwt-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# --- [DATABASES] ---
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/PTIT_Aka?retryWrites=true&w=majority"
MONGO_DB_NAME="PTIT_Aka"

# Redis Cache & Idempotency
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="uniflow_redis_secret"
REDIS_DB=0

# Qdrant Vector Engine
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME="uniflow_sku_vectors"

# --- [AI SERVICES & LLM GATEWAY] ---
# FPT GenAI / akaBot AI Platform
FPT_AI_API_KEY="your-fpt-ai-api-key-here"
FPT_AI_BASE_URL="https://api.fpt.ai/v1"

# 1. LLM Models:
# - Fast & JSON: DeepSeek-V4-Flash | gpt-oss-20b | gemma-3-27b-it
# - Deep Reasoning: Llama-3.3-70B-Instruct | gpt-oss-120b | GLM-5.2 | Qwen3.6-27B | gemma-4-31B-it
FPT_AI_FAST_MODEL="DeepSeek-V4-Flash"
FPT_AI_REASONING_MODEL="Llama-3.3-70B-Instruct"
FPT_AI_GENERAL_MODEL="Qwen3.6-27B"
FPT_AI_MODEL="DeepSeek-V4-Flash"

# 2. Vision & OCR: Qwen2.5-VL-7B-Instruct
FPT_AI_VISION_MODEL="Qwen2.5-VL-7B-Instruct"

# 3. Vector Embedding & Reranker:
FPT_AI_EMBEDDING_MODEL="Vietnamese_Embedding"
FPT_AI_RERANK_MODEL="bge-reranker-v2-m3"

# 4. Speech (STT & TTS):
FPT_AI_STT_MODEL="FPT.AI-whisper-large-v3-turbo"
FPT_AI_TTS_MODEL="FPT.TTS-pro"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
AI_ENGINE_URL="http://localhost:8000"

# --- [SERVICE INTERNAL URLS] ---
BACKEND_INTERNAL_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# --- [FRONTEND VITE CLIENT CONFIGURATION] ---
VITE_API_URL="http://localhost:3000/api/v1"
VITE_WS_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"
VITE_AI_ENGINE_URL="http://localhost:8000"
VITE_APP_TITLE="UniFlow AI - Nền tảng iPaaS TMĐT 0-Chạm"
