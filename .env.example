# ==============================================================================
# UNIFLOW AI - GLOBAL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- [APP ENVIRONMENT] ---
NODE_ENV="development"
PORT=3000
AI_ENGINE_PORT=8000
FRONTEND_PORT=5173

# --- [BRAND COLORS & THEMING] ---
BRAND_PRIMARY_COLOR="#ed1c24"
BRAND_SECONDARY_COLOR="#fcc20f"
BRAND_NAME="UniFlow AI"

# --- [SECURITY & ENCRYPTION] ---
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="uniflow-jwt-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# --- [DATABASES] ---
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/PTIT_Aka?retryWrites=true&w=majority"
MONGO_DB_NAME="PTIT_Aka"

# Redis Cache & Idempotency
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="uniflow_redis_secret"
REDIS_DB=0

# Qdrant Vector Engine
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME="uniflow_sku_vectors"

# --- [AI SERVICES] ---
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
AI_ENGINE_URL="http://localhost:8000"

# --- [SERVICE INTERNAL URLS] ---
BACKEND_INTERNAL_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# --- [FRONTEND VITE CLIENT CONFIGURATION] ---
VITE_API_URL="http://localhost:3000/api/v1"
VITE_WS_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"
VITE_AI_ENGINE_URL="http://localhost:8000"
VITE_APP_TITLE="UniFlow AI - Nền tảng iPaaS TMĐT 0-Chạm"
