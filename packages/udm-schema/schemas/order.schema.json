{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UniversalOrderModel",
  "type": "object",
  "required": ["meta", "order"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["traceId", "tenantId", "sourcePlatform", "sourceShopId", "createdAt", "ingestedAt"],
      "properties": {
        "traceId": { "type": "string" },
        "tenantId": { "type": "string" },
        "sourcePlatform": { "type": "string" },
        "sourceShopId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ingestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "order": {
      "type": "object",
      "required": ["sourceOrderId", "status", "currency", "totals", "customer", "items"],
      "properties": {
        "sourceOrderId": { "type": "string" },
        "status": { "type": "string" },
        "currency": { "type": "string", "default": "VND" },
        "totals": {
          "type": "object",
          "required": ["subtotal", "grandTotal"],
          "properties": {
            "subtotal": { "type": "number" },
            "discountPlatform": { "type": "number", "default": 0 },
            "discountSeller": { "type": "number", "default": 0 },
            "shippingFeePaid": { "type": "number", "default": 0 },
            "grandTotal": { "type": "number" }
          }
        },
        "customer": {
          "type": "object",
          "required": ["shippingAddress"],
          "properties": {
            "maskedName": { "type": "string" },
            "maskedPhone": { "type": "string" },
            "shippingAddress": {
              "type": "object",
              "required": ["fullAddress", "city", "district", "ward"],
              "properties": {
                "fullAddress": { "type": "string" },
                "city": { "type": "string" },
                "district": { "type": "string" },
                "ward": { "type": "string" },
                "postalCode": { "type": "string" }
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lineItemId", "sourceSkuCode", "sourceItemName", "quantity", "unitPrice"],
            "properties": {
              "lineItemId": { "type": "string" },
              "sourceSkuCode": { "type": "string" },
              "sourceItemName": { "type": "string" },
              "sourceVariationText": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "unitPrice": { "type": "number" },
              "mappedMasterSku": { "type": "string" },
              "mappingConfidence": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
