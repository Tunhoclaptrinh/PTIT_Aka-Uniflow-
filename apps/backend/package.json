{
  "name": "@uniflow/backend",
  "version": "1.0.0",
  "description": "UniFlow AI - Core NestJS API Gateway, Inbound Webhook Pipeline & UDM Normalizer",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
