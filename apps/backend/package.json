    "@nestjs/websockets": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/mongoose": "^10.0.6",
    "@uniflow/shared-types": "*",
    "@uniflow/udm-schema": "*",
    "bullmq": "^5.7.12",
    "ioredis": "^5.4.1",
    "mongoose": "^8.3.4",
    "axios": "^1.6.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
